# Direct Postgres connection string, used by SQLAlchemy for queries. Supabase
# is treated as vanilla Postgres here — no supabase-py, no REST/PostgREST API.
# Local dev default when running `supabase start`: postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres

# This backend's own JWT signing secret (see src/app/modules/auth/auth.py) —
# it mints and verifies its own tokens, no external auth provider involved.
# Any random string for local dev, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# Restrict CORS to the frontend's origin.
FRONTEND_URL=http://localhost:3000
