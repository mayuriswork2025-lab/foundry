# Base URL of the backend API (the Python FastAPI backend by default).
VITE_API_URL=http://localhost:8000

# Supabase project settings, used by the frontend's own supabase-js client to
# sign users in/out (Vite requires the VITE_ prefix to expose vars to client
# code). The resulting JWT is what gets sent to the backend as a bearer token.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
